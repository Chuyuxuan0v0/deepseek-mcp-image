{
  "name": "deepseek-mcp-image",
  "version": "0.1.0",
  "description": "MCP server that reads images via SenseNova 6.8 Flash-Lite multimodal model",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "deepseek-mcp-image": "src/index.js",
    "deepseek-mcp-image-gallery": "gallery-server.mjs"
  },
  "files": [
    "src",
    "gallery-server.mjs",
    "gallery.html",
    "imgs",
    "README.md",
    "README.en.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node src/index.js",
    "gallery": "node gallery-server.mjs",
    "test": "node --test test/*.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sensenova",
    "vision",
    "multimodal",
    "image",
    "dsh",
    "deepseek-harness"
  ],
  "license": "MIT",
  "author": "Chuyuxuan0v0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chuyuxuan0v0/deepseek-mcp-image.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
