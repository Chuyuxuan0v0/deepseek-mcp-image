# SenseNova
SENSENOVA_API_KEY=
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# Mini Tools Image API（仅个人使用，不要提交真实密钥）
# 本地图片会上传到图床后再交给商汤；公网 http(s) URL 不会走图床。
#
# 推荐写法：
MINI_TOOLS_USER_ID=
MINI_TOOLS_API_KEY=
# MINI_TOOLS_DURATION=1-day
#
# 也支持与官方请求头同名的写法：
# X-API-User-ID=
# Authorization=Bearer mtu_live_your_key
